# =========================================================================
# workbuddy2api 环境变量模板
# -------------------------------------------------------------------------
# 用法：
#   1. 复制本文件为 .env：   cp .env.example .env
#   2. 按需修改下面的真实值（尤其是带 * 的敏感项）
#   3. .env 已被 .gitignore 忽略，绝不会提交到 git
#
# 注意：production 部署时，.env 中的值与本地开发不同，请单独在服务器创建。
# =========================================================================

# ---------- 数据库 / 缓存 ----------
# * 生产必填：MySQL 连接串（含真实密码）
ADMIN_DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/workbuddy_admin?charset=utf8mb4
ADMIN_REDIS_URL=redis://127.0.0.1:6379/0

# ---------- 上游后端（CodeBuddy / WorkBuddy） ----------
ADMIN_BACKEND=https://copilot.tencent.com

# 本机桌面端登录态目录（用于后台的「扫描本机账号 / 注入本机」）
# ・单机前台运行（start_admin.bat）用下面的 %LOCALAPPDATA% 写法即可；
# ・以 Windows 服务（LocalSystem）方式运行时**必须写成绝对路径** ——
#   SYSTEM 的 %LOCALAPPDATA% 会指向 C:\Windows\system32\config\systemprofile\AppData\Local
#   （通常是空的），于是凭据一个都找不到。
#   例：ADMIN_CLIENT_AUTH_DIR=C:\Users\you\AppData\Local\CodeBuddyExtension\Data\Public\auth
#   不必为此改服务的登录账户：SYSTEM 对该目录本就有读权限。
ADMIN_CLIENT_AUTH_DIR=%LOCALAPPDATA%\CodeBuddyExtension\Data\Public\auth

# ---------- 管理后台登录 ----------
# * 两项都必填，没有默认值。未配置时后台登录返回 503，
#   不会退化成 admin/admin123 这类众所周知的口令（服务默认监听 0.0.0.0）。
ADMIN_USERNAME=
# * 后台登录密码（建议 >=12 位，勿用弱口令）
ADMIN_PASSWORD=
# * JWT 签名密钥，生产务必设为 >=32 字节的随机串，例如：
#   ADMIN_JWT_SECRET=$(python -c "import secrets;print(secrets.token_hex(32))")
ADMIN_JWT_SECRET=JWT_EXAMPLE_123456
ADMIN_JWT_EXPIRE_HOURS=24

# ---------- 服务监听 ----------
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8790

# ---------- /v1/messages（Anthropic Messages API，给 Claude Code 用） ----------
# 该端点与 /v1/chat/completions 共用同一套 Key 配额 / 用量记账 / 号池调度，
# 所以 Claude Code 也能直接吃后台号池，不必再走 /gw 那条「单账号、无配额」的旁路。
# 另提供 /v1/messages/count_tokens（本地粗估，不请求上游）。
#
# Claude Code 发的是 claude-opus-* / claude-sonnet-* / claude-haiku-* 模型名，
# 上游不认，按下面三个档次映射到本后台白名单里的模型名。
# * 不要设成 auto：本后台的 auto 是「取第一个启用的模型」，
#   在 28 个模型里可能挑到 hunyuan-chat 之类不适合写代码的，甚至图像模型。
# * 优先级提醒：若客户端（CC Switch / ~/.claude/settings.json）已经直接填了上游模型名
#   （例如 ANTHROPIC_DEFAULT_SONNET_MODEL=glm-5.2），该名字本就在白名单里，
#   会被**原样透传**，下面的档次映射根本不参与 —— 想让不同档位用不同模型，
#   直接在客户端按档位配更直观（界面显示的也会是真实模型）。
#   下面的映射只在客户端发 claude-* 这类上游不认识的名字时兜底。
ADMIN_ANTHROPIC_MODEL_OPUS=deepseek-v4-pro
ADMIN_ANTHROPIC_MODEL_SONNET=glm-5.2
ADMIN_ANTHROPIC_MODEL_HAIKU=glm-5.3-flash
#
# harness 脱敏开关。Claude Code 的 system prompt / tools 是固定模板，内含
# "DoS attacks / exploit development / credential testing" 这类**拒绝作恶**的合规声明，
# 会被上游内容审核当成敏感内容，整条请求被拒，报错就是：
#   400 {"code":11128,"msg":"Illegal API invocation from an unapproved channel"}
# 开启后会压缩 harness 并给敏感词插零宽空格（模型读到的仍是原词，后端关键词匹配失效）。
# * 默认必须开。关掉的话，简单 hello 测试能过、真实 Claude Code 请求必被拦。
ADMIN_ANTHROPIC_DESENSITIZE=1
# 配合上项：只做零宽脱敏、跳过 harness 压缩（保留 system 原文，误拦风险略高）
ADMIN_ANTHROPIC_NO_COMPACT=0

# ---------- 内嵌 /gw 网关（OpenAI / Anthropic / Responses 三种协议） ----------
# 端点：/gw/v1/chat/completions、/gw/v1/responses、/gw/v1/messages（Claude Code 用）、
#       /gw/v1/models、/gw/v1/balance、/gw/health
# * 网关要求携带的 API Key（X-Api-Key: xxx 或 Authorization: Bearer xxx）。
#   **留空则整个 /gw 不会被挂载（fail-closed）** —— 这是有意的：
#   converter._check_auth() 的实现是 `if not key: return`，一旦挂上去而 Key 为空，
#   /gw/v1/* 全部接口就对任何访问者开放，可任意白嫖账号额度。
#   服务默认监听 0.0.0.0，所以宁可少一个功能，也不要一个默认开放的后门。
CONVERTER_API_KEY=
# 内嵌 /gw 读取桌面端登录凭据的目录。
# 注意：这与上面的 ADMIN_CLIENT_AUTH_DIR 是两个不同的变量 ——
#   ADMIN_CLIENT_AUTH_DIR 给后台「扫描本机 / 注入切换」用；
#   CODEBUDDY_AUTH_DIR    给 converter 找凭据用。
# 留空则按当前用户的 %LOCALAPPDATA%\CodeBuddyExtension\Data\Public\auth 推断；
# 若本服务以 SYSTEM 等非桌面登录账户运行，必须显式指定，否则 /gw 会全部返回 503。
# CODEBUDDY_AUTH_DIR=%LOCALAPPDATA%\CodeBuddyExtension\Data\Public\auth
# 内嵌 /gw 的脱敏开关与日志路径（默认启用脱敏）
CONVERTER_DESENSITIZE=1
# CONVERTER_LOG=logs/converter-embedded.log

# ---------- 接口文档（OpenAPI） ----------
# 是否对公网开放 /docs、/redoc、/openapi.json 以及 /gw/docs、/gw/openapi.json。
# 默认 0（关闭）。理由：对攻击者来说它就是一份现成的完整攻击面清单 ——
# 2026-09-24 的外部审计正是靠 /openapi.json 里「这批路径鉴权参数为空」
# 一眼定位到 /api/growth/* 那个未授权漏洞的。只在本地排障时开。
ADMIN_ENABLE_DOCS=0

# ---------- 计费估算（上游未回传 credits 时的兜底系数，每千 token 积分） ----------
ADMIN_COST_PER_TOKEN=0.01

# ---------- 上游请求头 ----------
# 上游记录客户端 IP 时使用的 header 名；留空则发送常见头（X-Forwarded-For 等）
ADMIN_UPSTREAM_CLIENT_HEADER=
# 上游用量「client」列显示的产品名（X-IDE-Name）
ADMIN_UPSTREAM_CLIENT_NAME=WorkBuddy

# ---------- WorkBuddy 桌面端位置与版本（自动发现，通常无需配置） ----------
# 网关要伪装成官方桌面端，就必须报**本机真实安装的版本号**（UA 形如
# `WorkBuddy/<桌面端版本> WorkBuddy/<同版本> CLI/<CLI版本>`）。写死版本号的话，
# 官方一发版我们就变成「自报旧版本」，既是明显特征，也容易被版本闸门拦下。
#
# 因此这些值默认从本机安装包里读，无需在此配置：
#   安装目录   <- 自动扫描（见下方 WORKBUDDY_DRIVES）
#   桌面端版本 <- resources/install-manifest.json 的 appVersion
#                 （回退 cli/product.json 的 genieVersion、WorkBuddy.exe 资源）
#   CLI 版本   <- cli/dist/codebuddy.js 内嵌的 @tencent-ai/codebuddy-code 版本
#   风控通道   <- cli/product.json 的 config.turingSdk.channelId
#
# 找不到安装包时会退化成内置兜底值（服务仍能启动，但不保证版本准确）。
# 下面几项只在「自动发现失败」或「想强制指定」时才需要设置：

# 桌面端安装目录。留空 = 自动扫描。也可指向 resources\ 目录。
# 仅在装到了非标准位置（且不在下方扫描盘符内）时才需要设置。
# 例：WORKBUDDY_INSTALL_DIR=C:\Program Files\WorkBuddy
# WORKBUDDY_INSTALL_DIR=

# 直接指定 app.asar（比上面更精确，跳过整个扫描）。
# 例：WORKBUDDY_ASAR_PATH=E:\workbuddy\resources\app.asar
# WORKBUDDY_ASAR_PATH=

# 参与扫描的盘符列表（逗号分隔），用于自动定位安装目录。
# 默认 C,D,E,F,G。装在别的盘（比如 Z 盘）时把它加进来即可。
# WORKBUDDY_DRIVES=C,D,E,F,G

# 逆向产物（解包源码）的输出/查找目录。留空 = 用户缓存目录
#   Windows: %LOCALAPPDATA%\workbuddy2api\app_source
#   Linux  : ~/.cache/workbuddy2api/app_source
# 默认**不放在项目里**：解包产物有 200MB+，放进仓库会被 git 追着跑。
# 逆向产物不存在时，可用 `python wb_asar.py extract` 从 app.asar 自动产出，
# 不需要 Node / npm（内置纯标准库的 asar 读取器）。
# 也可以在**后台「设置 → 逆向产物」里点按钮拆包并指定目录**（见下方 DEV_TOOLS）。
# WORKBUDDY_SOURCE_DIR=

# ---------- 开发 / 测试辅助工具 ----------
# 后台「设置 → 逆向产物」面板：一键从 app.asar 解出客户端源码、手动指定安装目录、
# 检索源码。**生产环境不需要**（服务器上没有客户端安装包，也不该放 225MB 源码）。
# 设为 0 后 /api/app-source/* 全部返回 404，后台也不显示该区域。
# ADMIN_DEV_TOOLS=1

# 以下三项留空 = 自动从安装包读取；填了则**强制覆盖**（一般不要填）。
# WORKBUDDY_DESKTOP_VERSION=
# WORKBUDDY_CLI_VERSION=
# WORKBUDDY_TURING_CHANNEL_ID=

# ---------- 客户端参数档案（UA / 版本号 / 风控头 / 桌面指纹） ----------
# 出站请求要伪装成官方桌面端，涉及一批参数。它们现在由「客户端参数档案」
# 统一管理，优先级：环境变量 > （现场探测 / 后台保存）> 内置兜底。
#
# 后台「客户端参数」面板可以直接改这些值并保存，改完**立即生效**（无需重启），
# 且会随「同步到线上」一起推送到线上实例。
#
#   探测   ：扫描本机安装的 WorkBuddy，读出真实版本号 / 风控 channelId / commit
#   保存   ：把值写进数据库（system_settings.client_profile）
#   生效   ：发请求时实时读取
#
# 线上服务器**没装桌面端**，探测不到东西，所以它必须用「钉住已保存值」
# （source=saved）策略，靠同步过来的档案报出正确版本号。否则线上 UA 会退化成
# 内置兜底版本 —— 那是一个「谁也不认识的版本」，等于自报家门。
#
# 取值策略（可在后台切换，无对应环境变量）：
#   auto  = 优先现场探测（本机装了客户端时用它，版本升级后自动跟上）
#   saved = 钉住已保存值（线上实例必须用这个）

# 强制指定整条 UA（三段式 WorkBuddy/<v> WorkBuddy/<v> CLI/<cli>）。
# 注意：**不要**用后台保存 UA —— 它由两个版本号自动派生，单独保存会变成陈旧值。
# 只有确实需要覆盖整条 UA 时才用这个环境变量。
# WORKBUDDY_USER_AGENT=

# 桌面事件指纹（遥测）参数。一般不必设置，保留官方默认即可。
# 注意 product（请求头 X-Product）与 fp_product（遥测里的产品形态）**不是一回事**：
# 官方前者报 WorkBuddy、后者报 SaaS，混用会让遥测产品字段变成客户端名。
# WORKBUDDY_IDE_NAME=WorkBuddy
# WORKBUDDY_EXT_NAME=workbuddy-desktop
# WORKBUDDY_OS=win32
# WORKBUDDY_ARCH=x64
# WORKBUDDY_OS_VERSION=10.0.26220
# WORKBUDDY_CPU_CORES=20
# WORKBUDDY_MEMORY_SIZE=24
# WORKBUDDY_COMMIT=
# WORKBUDDY_RELEASE_DATE_MS=

# Turing Shield 设备风控 SDK 目录（留空 = 自动发现）。
# 通常不需要设置，helper 会从安装目录自动找到。
# WORKBUDDY_TURING_SDK_DIR=
# 风控 SDK 的产品名（默认 WorkBuddy）与调试开关（置 1 打印取值来源）
# WORKBUDDY_TURING_PRODUCT_NAME=WorkBuddy
# WORKBUDDY_TURING_DEBUG=0
# 风控 helper 额外扫描的盘符（留空则跟随 WORKBUDDY_DRIVES，再兜底 C,D,E,F）
# WORKBUDDY_TURING_DRIVES=

# 跑一遍环境自检，确认 Python/Node/依赖/桌面端/风控 SDK/MySQL/Redis 是否齐备：
#   python wb_envcheck.py            # 人类可读报告
#   python wb_envcheck.py --json     # 机器可读

# ---------- 账号选择策略 ----------
# remain（剩余最多优先）/ lru（最久未用优先）/ weighted（三因子加权随机：
# 余额占比×10 + 快过期积分占比×8 + 闲置补偿，Top-5 短名单内抽签）
ADMIN_ACCOUNT_SELECT=remain

# ---------- 流量治理：并发 / 限流 / 会话粘性 ----------
# 单账号最大在途请求数（0 = 不限）。粘性路由与加权选号都会倾向少数账号，
# 叠加长连接后单号容易过载，上游按账号限速时会成片 429；在途上限把并发摊平到全池。
ADMIN_POOL_MAX_IN_FLIGHT=3
# 单请求最多换号次数。
# 号池通常有十几个账号，设太小会出现「已尝试 3 个账号」而用户以为号池坏了。
# ⚠️ 取舍：transport 类失败（如上游流静默）每个账号要等满 STREAM_IDLE_TIMEOUT
# （默认 180s）才失败，所以调大它会线性拉长最坏等待（6 × 180s = 18 分钟）。
# 它只在「首个账号卡住、后续账号快速失败」时有净收益。保守可设回 3。
ADMIN_POOL_MAX_ROTATE=6
# 会话粘性：同一会话固定同一账号（上游前缀缓存不碎、多轮更快更省、逐轮跳号是批量特征）
ADMIN_SESSION_STICKY=1
# 会话绑定的空闲 TTL（秒）与 GC 周期（秒），滚动续期、空闲即释放
ADMIN_SESSION_STICKY_TTL=1800
ADMIN_SESSION_STICKY_GC=300
# 软限流（429）冷却基数（秒）与指数退避封顶（秒）
ADMIN_POOL_SOFT_RATE=600
ADMIN_POOL_SOFT_RATE_MAX=7200
# 熔断：连续失败阈值 / 冷却基数（秒）/ 封顶（秒）
ADMIN_POOL_BREAKER_THRESHOLD=5
ADMIN_POOL_BREAKER_COOLDOWN=600
ADMIN_POOL_BREAKER_COOLDOWN_MAX=21600
# 连续多少次「session 已死」(12153) 才禁用账号（一次就禁用会误杀）
ADMIN_POOL_SESSION_DEAD_THRESHOLD=3
# 模型级限流（code 6004）兜底退避（秒）；只冷却该模型，账号对别的模型仍可用
ADMIN_POOL_MODEL_SOFT_RATE=600
# 该后端无此模型（code 11102）的负缓存 TTL（秒），重试无意义
ADMIN_POOL_MODEL_BLOCK=21600

# ---------- 超时（关键：流式绝不设总时长） ----------
# 连接超时（秒）：连不上就快速换号，不让用户干等。
# 注意 httpx 的 timeout=300 是 connect/read/write/pool 各 300s，不是总时长；
# 原代码 connect=300 会让一个连不上的账号干等 5 分钟，这才是「卡住不动」的主因。
ADMIN_STREAM_CONNECT_TIMEOUT=15
# 流式**静默**超时（秒）：两次数据之间的最大间隔。有数据就续期，
# 所以长时间推理只要还在吐字就永不被掐断（等价于 SSE 空闲监控）。
# 官方客户端源码里 Node 默认 300s 的**总**requestTimeout 会掐断活跃 SSE，是必修的坑。
ADMIN_STREAM_IDLE_TIMEOUT=180
# 上传 prompt 超时（秒）与连接池等待超时（秒，池满则快速失败交给上层退避）
ADMIN_STREAM_WRITE_TIMEOUT=60
ADMIN_STREAM_POOL_TIMEOUT=20

# ---------- token 保活 ----------
# 是否启用每日 token 保活刷新（长期无请求的号登录态会静默失效）
ADMIN_KEEPALIVE_ENABLED=1
# 保活整点（本地时区，逗号分隔可多个）；默认 22 点，即没人用号的时候做
ADMIN_KEEPALIVE_HOURS=22
# 保活时账号之间的最小间隔（秒），批量并发刷新 token 是明显的机器特征
ADMIN_KEEPALIVE_ACCOUNT_GAP=0.8

# ---------- 登录防爆破 ----------
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_SECONDS=300
ADMIN_LOGIN_LOCK_SECONDS=900

# ---------- CORS ----------
# 留空或 * 表示允许任意来源；限制可设 ADMIN_CORS_ORIGINS=https://a.com,https://b.com
ADMIN_CORS_ORIGINS=*
